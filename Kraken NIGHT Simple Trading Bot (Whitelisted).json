      "name": "VolVar"
    },
    {
      "parameters": {
        "jsCode": "// Get the trades data - handle different input structures\nlet trades;\n\n// Check if items[0] has the expected structure\nif (items[0] && items[0].json && items[0].json.result && items[0].json.result.trades) {\n    trades = items[0].json.result.trades;\n} else {\n    // Handle case where data might be structured differently\n    console.log(\"Unexpected data structure:\", JSON.stringify(items[0], null, 2));\n    return [{ json: { error: \"No trades data found\" } }];\n}\n\nconst adaTrades = [];\n\n// Extract all ADA trades with their keys\nfor (const [key, trade] of Object.entries(trades)) {\n    if (trade.pair === 'NIGHTUSD') {\n        adaTrades.push({\n            key: key,\n            ...trade\n        });\n    }\n}\n\n// Check if we found any ADA trades\nif (adaTrades.length === 0) {\n    return [{ json: { error: \"No NIGHT trades found\" } }];\n}\n\n// Sort by time (most recent first) and get the last one\nconst lastAdaTrade = adaTrades.sort((a, b) => b.time - a.time)[0];\n\nreturn [{ json: lastAdaTrade }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        384
      ],
      "id": "1987f97a-09b0-4cc9-9cd0-58e3f46d4109",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// Get the required values\nconst askPrice = parseFloat(items[0].json.result.NIGHTUSD.a[0]); // Ask price\nconst bidPrice = parseFloat(items[0].json.result.NIGHTUSD.b[0]); // Bid price\nconst latestTradePrice = parseFloat($('Code').item.json.price);\n\n// Calculate pdelta for both ask and bid\nconst askPdelta = ((askPrice - latestTradePrice) / latestTradePrice) * 100;\nconst bidPdelta = ((bidPrice - latestTradePrice) / latestTradePrice) * 100;\n\n// Determine trading decision based on appropriate price\nlet decision;\nlet justification;\n\nif (bidPdelta < -$('VolVar').first().json.percentagechange) {\n  // Use bid price for selling (we sell at bid)\n  decision = \"BUY\";\n  justification = `Ask: ${askPrice}, Bid: ${bidPrice}, Latest Trade: ${latestTradePrice}, Bid pdelta: ${bidPdelta.toFixed(2)}%. Buy signal triggered as bid pdelta fell below % threshold.`;\n} else if (askPdelta > $('VolVar').first().json.percentagechange) {\n  // Use ask price for buying (we buy at ask)\n  decision = \"SELL\";\n  justification = `Ask: ${askPrice}, Bid: ${bidPrice}, Latest Trade: ${latestTradePrice}, Ask pdelta: ${askPdelta.toFixed(2)}%. Sell signal triggered as ask pdelta rose above % threshold.`;\n} else {\n  decision = \"DO NOTHING\";\n  justification = `Ask: ${askPrice}, Bid: ${bidPrice}, Latest Trade: ${latestTradePrice}, Ask pdelta: ${askPdelta.toFixed(2)}%, Bid pdelta: ${bidPdelta.toFixed(2)}%. No action needed as neither crossed thresholds.`;\n}\n\n// Return the result in JSON format\nreturn [{\n  json: {\n    decision: decision,\n    justification: justification,\n    askPrice: askPrice,\n    bidPrice: bidPrice,\n    askPdelta: parseFloat(askPdelta.toFixed(2)),\n    bidPdelta: parseFloat(bidPdelta.toFixed(2)),\n    latestTradePrice: latestTradePrice\n  }\n}];"
      },
