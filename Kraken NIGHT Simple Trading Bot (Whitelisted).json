    {
      "parameters": {
        "jsCode": "const crypto = require('node:crypto');\nconst apiKey = $('Configuration').first().json.kkpuikey ;\nconst privateKey = $('Configuration').first().json.kkpvkey ;\nconst nonce = (Date.now() * 1000).toString();  // Microseconds\nconst path = '/0/private/AddOrder';\n\n// Reference your volume variable here\nconst volume = $node[\"VolVar\"].json[\"volume\"];\n\nconst payload = `nonce=${nonce}&ordertype=market&type=sell&volume=${volume}&pair=NIGHTUSD`;\n\nconst getMessageSignature = (path, request, secret, nonce) => {\n  const message = request;\n  const secret_buffer = new Buffer(secret, 'base64');\n  const hash = new crypto.createHash('sha256');\n  const hmac = new crypto.createHmac('sha512', secret_buffer);\n  const hash_digest = hash.update(nonce + message).digest('binary');\n  const hmac_digest = hmac.update(path + hash_digest, 'binary').digest('base64');\n  return hmac_digest;\n};\n\nreturn {\n  apiKey: apiKey,\n  signature: getMessageSignature(path, payload, privateKey, nonce),\n  body: payload,\n  nonce: nonce,\n  volume: volume,  // Use the variable here too\n  pair: \"IAGUSD\"\n};"
